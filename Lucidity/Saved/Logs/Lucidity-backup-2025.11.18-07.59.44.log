[2025.11.17-15.55.02:657][506]LogFabLauncher: Debug payload: [{"id":"f70292d9-e69f-4057-bcc3-4a2c1aa41398","path":"C:/ProgramData/Epic/EpicGamesLauncher/VaultCache/FabLibrary/High_Quality_Cradboard_Boxes_Pack_-_PBR_Low-Poly_Game_Ready_Storage_Box-f70292d9/obj","meshes":[{"file":"C:/ProgramData/Epic/EpicGamesLauncher/VaultCache/FabLibrary/High_Quality_Cradboard_Boxes_Pack_-_PBR_Low-Poly_Game_Ready_Storage_Box-f70292d9/obj/cardboard_boxes_obj.obj","name":"","material_index":-1,"lods":[]}],"materials":[],"native_files":[],"additional_textures":[],"metadata":{"launcher":{"version":"0.0.1","listening_port":24563},"fab":{"assetNamespace":"","listing":{"averageRating":5,"createdAt":"","description":"<p><span>This free 3D-model of the carboard boxes is an example of what you will receive when purchasing any model from our library.&nbsp;</span><span>Check out to the full range of&nbsp;our 3D assets that we have carefully created for your needs!</span><span>The model is fully optimized and ready to import into the </span><strong>Unreal Engine&nbsp;</strong><span>or</span><strong>&nbsp;Unity</strong><span> - proper textures are included!</span><span>It was modeled in Autodesk Maya 2022, textured in Substance Painter and rendered with Arnold in Autodesk Maya.</span></p><p></p><p><span>- Box #1 has 160 triangles / 82 vertices</span></p><p><span>- Box #2 has 214 triangles / 109 vertices</span></p><p><span>- Box #3 has 256 triangles / 130 vertices</span></p><p><span>- All folders have appropriate naming and sorted correctly</span></p><p><span>- The models are centered and real-world scaled</span></p><p></p><p><span>What's inside:</span></p><p></p><p><span>- <strong>Fbx</strong> includes 3D model in .fbx format</span></p><p><span>- <strong>Obj</strong> includes 3D model in .obj format</span></p><p><span>- <strong>Metal-Rough Textures</strong> includes 4k texture maps in a metallic-roughness pipeline: BaseColor, Height, Metalness, Normal, Roughness</span></p><p><span>- <strong>UE Textures</strong> includes 4k texture maps for <em>Unreal Engine</em>: Albedo, Normal, Occlusion-Roughness-Metallic</span></p><p><span>- <strong>Unity Textures</strong> includes 4k texture maps for <em>Unity Engine</em>: Base Map, Mask Map, Normal, AmbientOcclusion</span></p><p></p><p><span><em>If you'll have any questions or need assistance - feel free to contact!</em></span></p><p><span><em>Have a nice day!</em></span></p>","isAiForbidden":true,"isAiGenerated":false,"lastUpdatedAt":"2025-04-24T15:59:08.748941Z","listingType":"3d-model","media":"https://media.fab.com/image_previews/gallery_images/fbb7ad13-5192-4970-aa15-16e52cb3bb4f/be4586ed-4245-4ec2-b880-43bcedaadba2.jpg","publishedAt":"2024-12-07T11:41:56.152528Z","reviewCount":1,"thumbnail":"https://media.fab.com/image_previews/gallery_images/82c6c941-0be9-41d7-883a-046065d7801f/d0c75290-1d5d-41e1-9cfe-69c4d0d0917c.jpg","title":"High Quality Cradboard Boxes Pack - PBR Low-Poly Game Ready Storage Box","uid":"f70292d9-e69f-4057-bcc3-4a2c1aa41398","updatedAt":"","user":{"coverImageUrl":"https://cdn1.epicgames.com/fab/seller/o-x9srrqgz4n5gq83p6kv8cpk6qau2rv/cover/11a96cce.png","profileImageUrl":"https://cdn1.epicgames.com/fab/seller/o-x9srrqgz4n5gq83p6kv8cpk6qau2rv/profile/5fa2edd7.png","sellerName":"BLISS GRAPHICS","uid":"eccf4d12-9bb4-483c-8683-f9db23a58b9b"},"tags":[{"name":"Pbr","slug":"pbr","uid":"080edd3b-d10a-4f32-ace2-30f5baa480dc"},{"name":"Warehouse","slug":"warehouse","uid":"14fabac0-b646-4416-a0da-9f710846e623"},{"name":"Mail","slug":"mail","uid":"2f14bf63-b807-47d7-8e46-06767cfd0495"},{"name":"Box","slug":"box","uid":"3aee29bc-58db-41cc-ac48-4cfc238ae87e"},{"name":"Logistics","slug":"logistics","uid":"3d1655a5-8518-48f7-85d7-a8893784d4f0"},{"name":"Lowpoly","slug":"lowpoly","uid":"451806dc-649e-43b7-9c2e-a54485de14b6"},{"name":"Paper","slug":"paper","uid":"4bd64ed2-6adc-4b0c-9f08-b6bfdc43b924"},{"name":"Package","slug":"package","uid":"513b1da6-89f1-47ed-a7f7-e369d45c0f58"},{"name":"Delivery","slug":"del